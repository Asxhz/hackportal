{
  "name": "hackportal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gate": "bash scripts/preflight.sh",
    "typecheck": "tsc --noEmit -p .",
    "db:start": "supabase start",
